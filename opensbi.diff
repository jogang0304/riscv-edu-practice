diff -ruN opensbi2/lib/sbi/sbi_ecall_mcycle.c opensbiMy/lib/sbi/sbi_ecall_mcycle.c
--- opensbi2/lib/sbi/sbi_ecall_mcycle.c	1970-01-01 03:00:00.000000000 +0300
+++ opensbiMy/lib/sbi/sbi_ecall_mcycle.c	2026-05-05 22:11:20.912386223 +0300
@@ -0,0 +1,34 @@
+#include <sbi/sbi_trap.h>
+#include <sbi/sbi_error.h>
+#include <sbi/sbi_ecall.h>
+#include <sbi/sbi_ecall_interface.h>
+#include <sbi/riscv_encoding.h>
+#include <sbi/riscv_asm.h>
+
+#define SBI_EXT_MCYCLE 0x09ABCDEF
+
+static int sbi_ecall_mcycle_handler(unsigned long extid, unsigned long funcid,
+				    struct sbi_trap_regs *regs,
+				    struct sbi_ecall_return *out_val)
+{
+	if (funcid == 0) {
+		*out_val = csr_read(CSR_MCYCLE);
+		return 0;
+	}
+	return SBI_ENOTSUPP;
+}
+
+struct sbi_ecall_extension ecall_mcycle;
+
+static int sbi_ecall_mcycle_register_extensions(void)
+{
+	return sbi_ecall_register_extension(&ecall_mcycle);
+}
+
+struct sbi_ecall_extension ecall_mcycle = {
+	.name		     = "Mcycle",
+	.extid_start	     = SBI_EXT_MCYCLE,
+	.extid_end	     = SBI_EXT_MCYCLE,
+	.register_extensions = sbi_ecall_mcycle_register_extensions,
+	.handle		     = sbi_ecall_mcycle_handler,
+};
